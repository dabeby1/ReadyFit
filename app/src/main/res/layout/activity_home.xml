
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10120F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="READYFIT"
            android:textColor="#9DBA55"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="25dp"
            android:paddingBottom="18dp" />

        <ImageView
            android:id="@+id/imgUnit"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:contentDescription="תמונת יחידת היעד" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="היעד שלך"
                android:textColor="#8B9186"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTargetUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="יחידת יעד"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="25dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="הנתונים שלך"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/home_card"
                android:padding="18dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:id="@+id/txtAge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="גיל\n--"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtWeight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="משקל\n--"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtRunTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2 ק״מ\n--"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="האימון שלך להיום"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/workout_card"
                android:padding="22dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/txtWorkoutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="אימון READYFIT"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtWorkoutDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ריצה • כוח • סיבולת"
                    android:textColor="#C1C6BB"
                    android:textSize="16sp"
                    android:layout_marginBottom="15dp" />

                <TextView
                    android:id="@+id/txtWorkoutDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="משך משוער: 45 דקות"
                    android:textColor="#A8C25E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- כרטיס ניתוח חכם -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/home_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧠 הניתוח החכם שלי"
                    android:textColor="#9DBA55"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtAnalysisTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="טוען ניתוח..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtAnalysisExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="המערכת מנתחת את המשובים שלך"
                    android:textColor="#C1C6BB"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnStartWorkout"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:text="התחל אימון"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:backgroundTint="#718D3B"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnWorkoutHistory"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="📊  היסטוריית האימונים שלי"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#596D35"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="⚙  הגדרות ופרופיל"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#343832"
                android:layout_marginBottom="35dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
